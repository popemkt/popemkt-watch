<?xml version="1.0" encoding="utf-8"?>
<!--
  WatchCal launcher foreground: a bold calendar page with a strong checkmark —
  "calendar reminders, done" (the ✓ is the app's signature mark-done gesture).
  Deliberately simple and heavy-stroked so it survives downscaling to the tiny
  Wear launcher size. All marks sit within the central ~66dp safe zone of the
  108dp viewport so the circular Wear mask never clips them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Binder tabs poking above the page (drawn first so the page overlaps them) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41,26.5 A2.5,2.5 0 0 1 46,26.5 L46,34 L41,34 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,26.5 A2.5,2.5 0 0 1 67,26.5 L67,34 L62,34 Z" />

    <!-- Calendar page (rounded, white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M35,32 L73,32 A7,7 0 0 1 80,39 L80,75 A7,7 0 0 1 73,82 L35,82 A7,7 0 0 1 28,75 L28,39 A7,7 0 0 1 35,32 Z" />

    <!-- Header band -->
    <path
        android:fillColor="#0E7C66"
        android:pathData="M28,39 A7,7 0 0 1 35,32 L73,32 A7,7 0 0 1 80,39 L80,46 L28,46 Z" />

    <!-- Bold checkmark on the page -->
    <path
        android:strokeColor="#12A085"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M39,62 L49,72 L71,50" />
</vector>
