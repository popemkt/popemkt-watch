<?xml version="1.0" encoding="utf-8"?>
<!--
  WatchCal launcher foreground: a calendar page branded with a "P" (popemkt) in
  the header and a bold checkmark on the body — "popemkt calendar, done" (the ✓
  is the app's signature mark-done gesture). Heavy strokes so it survives
  downscaling to the tiny Wear launcher size; everything sits within the central
  ~66dp (radius 33) safe zone of the 108dp viewport, with clear margin to the
  circular Wear mask so no mark touches the edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Binder tabs poking above the page (drawn first so the page overlaps them) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,30.5 a1.8,1.8 0 0 1 3.6,0 L49.6,36 L46,36 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M58.4,30.5 a1.8,1.8 0 0 1 3.6,0 L62,36 L58.4,36 Z" />

    <!-- Calendar page (rounded, white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,34 L68,34 A7,7 0 0 1 75,41 L75,69 A7,7 0 0 1 68,76 L40,76 A7,7 0 0 1 33,69 L33,41 A7,7 0 0 1 40,34 Z" />

    <!-- Header band -->
    <path
        android:fillColor="#0E7C66"
        android:pathData="M33,41 A7,7 0 0 1 40,34 L68,34 A7,7 0 0 1 75,41 L75,50 L33,50 Z" />

    <!-- "P" monogram (popemkt) in the header -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M52,48 L52,36 L56,36 A3.2,3.2 0 0 1 56,42.4 L52,42.4" />

    <!-- Bold checkmark on the page body -->
    <path
        android:strokeColor="#12A085"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M41,61 L48,68 L67,53" />
</vector>
